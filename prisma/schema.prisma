// Asad Sticker & Auto Zone — Prisma schema (PostgreSQL / Neon)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Sticker categories: car, bike, wall (extensible)
model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  icon        String? // emoji or icon name for UI
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  price       Float // price in PKR
  salePrice   Float? // optional discounted price
  image       String // main image URL / path
  images      String? // JSON array of extra image URLs (stored as a JSON string)
  video       String? // optional product video URL / path
  // Sizes offered for this product, each with its own optional price, packed
  // into one free-text field so a new size never needs a migration. Format:
  // "10x10 cm=250 | 12x20 cm=400" — parsed by src/lib/sizes.ts.
  size        String?
  stock       Int      @default(0)
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  tags        String? // comma separated tags for search/SEO

  // What kind of sticker this is. Kept as a String (not a native enum) so new
  // types never need a DB migration — allowed values live in the app, see
  // STICKER_TYPES in src/lib/types.ts: CAR | BIKE | WALL | OTHER
  stickerType String  @default("OTHER")
  // Free text used only when stickerType is OTHER, e.g. "Laptop", "Truck Art".
  customType  String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([slug])
  @@index([stickerType])
}

// NOTE: `status` is kept as a String (not a native enum) so allowed values stay
// app-controlled. Enforced in the app (see ORDER_STATUSES in src/lib/types.ts):
// PENDING | CONFIRMED | PROCESSING | SHIPPED | DELIVERED | CANCELLED

model Order {
  id           String      @id @default(cuid())
  orderNumber  String      @unique // human-friendly e.g. CP-2026-0001
  customerName String
  phone        String
  email        String?
  address      String
  city         String
  notes        String?
  status       String      @default("PENDING")
  subtotal     Float
  shipping     Float       @default(0)
  total        Float
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String // snapshot of name at order time
  price       Float // snapshot of price at order time
  quantity    Int
  size        String? // size chosen at order time, e.g. "10x10 cm"

  @@index([orderId])
}
